{
  "name": "nanoleaf-lan",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "description": "Local-first Stream Deck control for Nanoleaf Essentials bulbs",
  "author": {
    "name": "Dead Frog Studios",
    "url": "https://deadfrogstudios.com"
  },
  "homepage": "https://deadfrogstudios.com",
  "scripts": {
    "clean": "rimraf dist com.deadfrogstudios.nanoleaflan.sdPlugin/bin",
    "build": "npm run clean && tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "streamdeck validate com.deadfrogstudios.nanoleaflan.sdPlugin",
    "pack": "npm run build && streamdeck pack com.deadfrogstudios.nanoleaflan.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "@elgato/utils": "^0.4.5",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@elgato/cli": "^1.6.0",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
